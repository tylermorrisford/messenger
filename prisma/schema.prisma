generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid(7))
  email               String    @unique
  emailVerifiedAt     DateTime?
  name                String?
  // bcrypt of the client-derived auth key, never of the password itself
  authHash            String
  kdfVersion          Int
  kdfMemLimit         Int
  kdfOpsLimit         Int
  keyBundle           String
  keyBundleNonce      String
  recoveryBundle      String
  recoveryBundleNonce String
  isAdmin             Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  keys            UserKey[]
  sessions        Session[]
  invitesSent     Invite[]  @relation("InviteInviter")
  invitesAccepted Invite[]  @relation("InviteAcceptedBy")

  @@map("users")
}

model UserKey {
  id         String    @id @default(uuid(7))
  userId     String
  version    Int
  x25519Pub  String
  ed25519Pub String
  createdAt  DateTime  @default(now())
  retiredAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@map("user_keys")
}

model Session {
  id           String    @id @default(uuid(7))
  userId       String
  refreshHash  String    @unique
  previousHash String?
  rotatedAt    DateTime?
  expiresAt    DateTime
  lastUsedAt   DateTime  @default(now())
  userAgent    String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([previousHash])
  @@map("sessions")
}

enum EmailCodePurpose {
  VERIFY
  LOGIN
  RECOVER
}

model EmailCode {
  id         String           @id @default(uuid(7))
  email      String
  purpose    EmailCodePurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int              @default(0)
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([email, purpose])
  @@map("email_codes")
}

model Invite {
  id               String    @id @default(uuid(7))
  tokenHash        String    @unique
  email            String
  conversationId   String?
  inviterId        String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdAt        DateTime  @default(now())

  inviter    User  @relation("InviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("InviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("invites")
}
