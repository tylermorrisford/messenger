generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid(7))
  email               String    @unique
  emailVerifiedAt     DateTime?
  name                String?
  // bcrypt of the client-derived auth key, never of the password itself
  authHash            String
  kdfVersion          Int
  kdfMemLimit         Int
  kdfOpsLimit         Int
  keyBundle           String
  keyBundleNonce      String
  recoveryBundle      String
  recoveryBundleNonce String
  isAdmin             Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  keys            UserKey[]
  sessions        Session[]
  invitesSent     Invite[]  @relation("InviteInviter")
  invitesAccepted Invite[]  @relation("InviteAcceptedBy")
  memberships     ConversationMember[]
  conversationKeys ConversationKey[]
  messages        Message[]
  deviceLinks     DeviceLink[]

  @@map("users")
}

model UserKey {
  id         String    @id @default(uuid(7))
  userId     String
  version    Int
  x25519Pub  String
  ed25519Pub String
  createdAt  DateTime  @default(now())
  retiredAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@map("user_keys")
}

model Session {
  id           String    @id @default(uuid(7))
  userId       String
  refreshHash  String    @unique
  previousHash String?
  rotatedAt    DateTime?
  expiresAt    DateTime
  lastUsedAt   DateTime  @default(now())
  userAgent    String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([previousHash])
  @@map("sessions")
}

model DeviceLink {
  // the new device's hash of the code it shows; the code itself never reaches the server
  id           String    @id
  ephemeralPub String
  mac          String
  userId       String?
  sealedBundle String?
  bundleMac    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("device_links")
}

enum EmailCodePurpose {
  VERIFY
  LOGIN
  RECOVER
}

model EmailCode {
  id         String           @id @default(uuid(7))
  email      String
  purpose    EmailCodePurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int              @default(0)
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([email, purpose])
  @@map("email_codes")
}

model Invite {
  id               String    @id @default(uuid(7))
  tokenHash        String    @unique
  email            String
  conversationId   String?
  inviterId        String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdAt        DateTime  @default(now())

  inviter      User?         @relation("InviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("InviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("invites")
}

enum MemberRole {
  OWNER
  MEMBER
}

model Conversation {
  id                String   @id @default(uuid(7))
  title             String?
  currentEpoch      Int      @default(1)
  // null means messages never expire
  defaultTtlSeconds Int?     @default(604800)
  needsRotation     Boolean  @default(false)
  // provenance only, no relation: the conversation must outlive its creator's account
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members  ConversationMember[]
  keys     ConversationKey[]
  messages Message[]
  invites  Invite[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String
  userId         String
  role           MemberRole @default(MEMBER)
  joinedAt       DateTime   @default(now())
  leftAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model ConversationKey {
  id                    String   @id @default(uuid(7))
  conversationId        String
  epoch                 Int
  recipientUserId       String
  recipientKeyVersion   Int
  wrappedKey            String
  // no relation: recipients must keep their wrapped key even if the distributor's account goes away
  distributorUserId     String
  distributorKeyVersion Int
  signature             String
  createdAt             DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recipient    User         @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([conversationId, epoch, recipientUserId])
  @@index([recipientUserId])
  @@map("conversation_keys")
}

model Message {
  id               String    @default(uuid(7))
  seq              BigInt    @default(autoincrement())
  conversationId   String
  senderId         String
  senderKeyVersion Int
  epoch            Int
  ttlSeconds       Int?
  nonce            String
  ciphertext       String
  signature        String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // partitioned by month on createdAt, and Postgres wants the partition key in every unique constraint
  @@id([id, createdAt])
  @@unique([seq, createdAt])
  @@index([conversationId, seq])
  @@index([expiresAt])
  @@map("messages")
}
